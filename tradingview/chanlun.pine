// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// 冲浪者 · 缠论结构（chanlun 引擎 v2.3 的 Pine 移植）
//
// 与 Python 引擎（core/）同一套口径，逐步照搬：
//   K线包含处理（第 65 课）→ 分型 → 笔（第 77 课，端点必为极值、带回头修正；可选第 81 课新笔）
//   → 线段（第 67 / 71 / 78 课，特征序列）→ 类中枢（笔构成）/ 线段中枢
//   → 中枢终结：三买三卖为主、中心定理一兜底（第 20 / 38 课）→ 满 9 段升级（第 33 / 64 课）
//   → 一二三类买卖点（第 20 / 21 / 24 课）；一买一卖还要过前提③（第 53 课，可关，默认开）
// 画法：笔与类中枢同色，线段与线段中枢同色；高一级别中枢用紫色加粗框；未完成的笔 / 线段一律虚线。
// 中枢边框按**规则 B** 分三档（顺序不能反）：① 前三笔（段）里夹着还没走完的那一员 ⇒ 整框虚线；
//   ② 中枢已结束 ⇒ 整框实线；③ 仍在延续 ⇒ 拆两截，前三那截实线、延续那截虚线（分界在第三个成员的终点）。
// 中枢切法：本移植画的是**「延伸」**那档（原文的延伸 / 扩展判定）。Python 引擎与网站 **2026-10-05 起缺省改成
//   「按转折切」**（线段中枢横跨更大一级走势的转折点时，在那个转折点切开；小栋拍板，card-21fbf426-889）
//   —— **这一档 pine 还没有移植**。⇒ 同一段行情，图上中枢边界与网站缺省视图**会不一样**；
//   `tools/pine_lockstep.py` 对齐的也仍然只是「延伸」。要跟网站缺省对齐，得另开一张卡做 pine 的转折切版本。
// 计算方式：**逐根增量**。包含处理 / 分型 / 笔 / 线段 / MACD 在每根K线上往下推一格（①②③ + MACD 递推），
//   只有最后一根（islast）才把中枢、买卖点**整段重算一遍**并落图 —— ④⑤ 这一段仍是「从头算」，
//   但扫的是笔 / 中枢 / 段、不是 K 线：中枢 zec15 末根约 4.5ms（扫 1135 笔），买卖点只扫候选 A/C 两段柱面积。
//   ④⑤ 留在 islast 是量出来的决定（notes/center-cost-probe.py、notes/signals-cost-probe.py），不是漏做。
// 买卖点：默认只标『结构已确认』的；打开『显示待确认』后，未确认的用空心标签，之后可能改掉或消失。
//
// ⚠⚠ **本文件不是每一步都被运行验证过。**
//   Python 引擎（core/）有 pytest 和数据对账；**Pine 这一侧没有运行时**（改动者本机跑不了 TradingView），
//   凡是与 Python 版"照搬"的段落，两边都只做了**静态对齐**（逐行读、逐处比坐标），**没有跑过**。
//   `tools/pine_lockstep.py` 能证明的是『输出在这 12 份数据上**没变**』—— 它**证不了**『Pine 与 Python 行为等同』：
//   真实行情上不触发的分支（例如线段起点的三笔重叠，见 `buildSegments`），在 lockstep 里**是看不见的**，
//   改了也照绿。⇒ **别把绿当等同。** 有 TradingView 环境的人请优先复跑本文件。
//@version=6
indicator("缠论 · 笔 / 线段 / 中枢 / 买卖点（中枢按延伸）", shorttitle = "缠论·延伸", overlay = true,
     max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500)

// ───────────────────────── 设置 ─────────────────────────
G1 = "口径（选定后一路保持，第 64 / 81 课）"
penRule   = input.string("老笔", "笔的标准", options = ["老笔", "新笔"], group = G1,
     tooltip = "老笔（第 77 课）：顶底分型之间至少隔一根独立K线。新笔（第 81 课）：包含处理后不共用K线，且两个极值K线之间原始K线 ≥ 3 根。")
tickSize  = input.float(0.0, "价格精度（0 = 用原始价格）", minval = 0.0, group = G1,
     tooltip = "第 64 课：精度一旦预设就要一路保持。填 0.1 表示高低价按 0.1 取整后再算。")
// 特征序列**合并方向**的两种口径（小栋 2026-10-02 ⑤；与 Python 引擎 core/segment.py 的 mode 一一对应）
featDir   = input.string("A 开头按线段方向", "特征序列合并方向", options = ["A 开头按线段方向", "B 全程按线段方向"], group = G1,
     tooltip = "第 67 课只说特征序列也要做非包含处理，没说合并方向怎么取。A（默认）＝开头按线段方向、之后按『最后两根』定方向；B＝全程按线段方向（chan.py / YuYuKunKun / ZenTheory 的做法）。默认 A 与历史输出一致。")
featModeB = featDir == "B 全程按线段方向"

G2 = "结构线（笔 / 线段）"
showPen   = input.bool(true,  "笔", inline = "p", group = G2)
penW      = input.int(1, "线宽", minval = 1, maxval = 5, inline = "p", group = G2)
penCol    = input.color(color.rgb(122, 137, 166), "笔的颜色", group = G2,
     tooltip = "#7A89A6 灰蓝。笔是图上最密的一层（数量是线段的 3~5 倍），退到后面去，别跟买卖点抢眼睛。与 Python 版 render/style.py 的 pen 同值。")
showSeg   = input.bool(true,  "线段", inline = "s", group = G2)
segW      = input.int(2, "线宽", minval = 1, maxval = 8, inline = "s", group = G2,
     tooltip = "默认 3 → 2（2026-10-02 小栋）。笔 1 / 线段 2 ＝ 2:1，线段仍然是「一眼看去的主线」，但不再压过买卖点。")
segCol    = input.color(color.rgb(196, 137, 1), "线段的颜色", group = G2,
     tooltip = "#C48901 金（原 #F2C14E 琥珀）。琥珀在**白底**图上只有 1.68:1 —— 浅黄挨着白就是「一块比较暗的白」，主线立不起来。" +
               "同色相（42°）里取彩度最高的那个解：白底 3.03 / 深底 5.90，两底都过。与 Python 版 render/style.py 的 seg 同值。")

G3 = "中枢（框 / 填充）"
showPC    = input.bool(false, "类中枢（与笔同色）", group = G3)
pcFillTr  = input.int(92, "类中枢填充透明度", minval = 0, maxval = 100, group = G3,
     tooltip = "Pine 的透明度：0 = 不透明、100 = 全透明。92 ≈ 8% 不透明（原 85 = 15%，色雾太糊）。与 Python 版 pc_fill 一致。")
showSC    = input.bool(true,  "线段中枢（与线段同色）", group = G3)
scFillTr  = input.int(90, "线段中枢填充透明度", minval = 0, maxval = 100, group = G3,
     tooltip = "90 ≈ 10% 不透明。线段中枢比类中枢重要，底色留得比它重一点。与 Python 版 sc_fill 一致。")
showUp    = input.bool(false, "高一级别中枢（满 9 段）", group = G3)
upColPen  = input.color(color.rgb(153, 141, 197), "高一级别 · 类中枢升上去的", group = G3,
     tooltip = "#998DC5 淡紫（原 #C4B5FD）。它跟母框是一家人（母框 = 笔的颜色），所以取笔那一族的色相往上提亮。" +
               "原色在**白底**上只有 1.85:1，框会「比白更白」等于没框；压暗到白底 3.01 / 深底 5.94，看框就知道谁升的。")
upColSeg  = input.color(color.rgb(217, 70, 239), "高一级别 · 线段中枢升上去的", group = G3,
     tooltip = "#D946EF 品红。线段中枢那一族升上来的。跟笔 / 线段 / 买卖点四个色都不撞，是这套配色里唯一没被占用的色相。")
// ★ 2026-10-02 小栋：两种升级中枢**分色**（原来它们是同一个 #A78BFA 紫），且**升级框不再加粗** ——
//   线宽直接取母框的 `w`，级别只由颜色和标签文字区分。加粗那条通道让给别的用途了。
upFillTr  = input.int(92, "高一级别填充透明度", minval = 0, maxval = 100, group = G3,
     tooltip = "92 ≈ 8% 的淡底（颜色跟着上面两个色走）。原先是写死的全透明（color.new(col, 100)），等于没填充。与 Python 版 up_fill 一致。")

G4 = "诊断"
selfCheck = input.bool(false, "实时回滚自检（挂个角标）", group = G4,
     tooltip = "打开后图角挂一个标签。回滚生效时恒为 ✓；不生效时第二个 tick 就会 ✗。" +
               "查的是数组（aM/zH），不是标量 —— 标量回滚不代表数组回滚。参照物是引擎值 bar_index。")
drawBars  = input.int(9000, "只画最近多少根K线里的结构", minval = 100, maxval = 9000, group = G4,
     tooltip = "TradingView 每种图形最多 500 个；太长的历史会画不全，所以只画最近这一段。")
segCheck  = input.bool(false, "线段逐根自检（挂个角标）", group = G4,
     tooltip = "打开后在 islast 把增量 (zPens, zSegs) 跟整段重算 buildSegments(zUnits(...)) 对一遍。" +
               "这是唯一取值级验证：语法解析只证写法、lockstep 只证结构、Python 参照证的是算法（另一门语言）。" +
               "B 模式下不生效（B 本来就整段重算）。" +
               "打开会让 islast 又变回 O(n)（仅这一次，用于真机对账，不影响逐根摊还）。")

G5 = "买卖点"
sigLevel  = input.string("线段中枢", "按哪层中枢判", options = ["线段中枢", "类中枢"], group = G5,
     tooltip = "线段中枢是原文承认的正规中枢（第 83 课）；类中枢由笔构成（第 64 课），信号多但稳定性差。")
measure   = input.string("MACD 柱面积", "背驰力度（一买一卖）", options = ["MACD 柱面积", "价格斜率"], group = G5,
     tooltip = "第 24 课：离开段（C 段）的 MACD 柱面积比进入段（A 段）小即背驰。斜率 = |价差| / K线根数。")
divRatio  = input.float(1.0, "背驰比例：C < A × ", minval = 0.1, maxval = 1.0, step = 0.05, group = G5)
p3On      = input.bool(true, "前提③：B 的中枢级别要大于 A、C 里的", group = G5,
     tooltip = "第 53 课：B 的中枢级别比 A、C 里的中枢级别都要大，否则 A、B、C 就连成一个大的中枢了。判法：上一层有没有中枢把 A、B、C 整段包住（严格口径，用中枢区间 [ZD, ZG]）。默认开，与引擎 core/signals.py 的 premise3=True 一致。")
mFast     = input.int(12, "MACD 快线", minval = 1, inline = "m", group = G5)
mSlow     = input.int(26, "慢线", minval = 2, inline = "m", group = G5)
mSig      = input.int(9, "信号", minval = 1, inline = "m", group = G5)
show1B    = input.bool(false, "一买", inline = "b", group = G5)
show2B    = input.bool(false, "二买", inline = "b", group = G5)
show3B    = input.bool(false, "三买", inline = "b", group = G5)
show1S    = input.bool(false, "一卖", inline = "x", group = G5)
show2S    = input.bool(false, "二卖", inline = "x", group = G5)
show3S    = input.bool(false, "三卖", inline = "x", group = G5)
showPend  = input.bool(false, "显示待确认（空心，可能重画）", group = G5)
buyCol    = input.color(color.rgb(0, 170, 104), "买点颜色", inline = "c", group = G5)
sellCol   = input.color(color.rgb(255, 86, 86), "卖点颜色", inline = "c", group = G5)

// ───────────────────────── 数据类型 ─────────────────────────
type Fx
    int   k        // 标准化序列下标
    int   i        // 贡献极值的那根原始K线（相对下标）
    bool  top
    float p

type Unit          // 笔或线段
    int   i0
    int   i1
    float p0
    float p1
    float hi
    float lo
    int   PI0 = -1 // 线段：起止笔序号
    int   PI1 = -1
    bool  live = false

type Ctr
    int   PI0
    int   PI1
    float ZD
    float ZG
    float DD
    float GG
    bool  live
    int   term     // 0 仍在延续 / 1 三买 / 2 三卖 / 3 Z 段向上离开 / 4 Z 段向下离开 / 5 所在线段结束
    int   rel      // 0 无 / 1 下跌延续 / 2 上涨延续 / 3 扩展·向下 / 4 扩展·向上 / 5 区间重叠
    int   seg = -1 // 归属哪条线段（-1 = 非段内算，如线段中枢）；类中枢只在同段内接续 rel/合成
    array<float> upZD
    array<float> upZG

type Sig
    int   kind     // 1 一买 2 二买 3 三买 4 一卖 5 二卖 6 三卖
    int   bar
    float price
    bool  confirmed
    bool  weak

// ───────────────────────── 逐根收集数据 ─────────────────────────
q(float p) => tickSize > 0 ? math.round(p / tickSize) * tickSize : p

contains(float ah, float al, float bh, float bl) => (ah >= bh and al <= bl) or (bh >= ah and bl <= al)

// ───────────────────────── K线：包含处理与分型（第 65 课）─────────────────────────
// ★ 逐根增量（本卡第①步）。原来是每根K线往 aH/aL 里存、在 barstate.islast 里把整段
//   standardize() + fractals() 重算一遍 —— 那就是 500ms/超时的来源。现在改成 var 状态，
//   每根只推进一步，islast 只负责画。
//
//   与 Python 侧 core/kline.py 的**批量**实现逐前缀等价：notes/pine-incremental-parity.py
//   （9 份真实数据 + 300 条随机行情，90804 个前缀，0 分歧；--self-test 两支正臂全红）。
//   等价靠的不变量：**一次推入只追加一根、或只改动最后一根**。因此
//     · 只有最后一个分型格子（k = 长度−2）的判据含被改动的元素 ⇒ 重算只需它一格；
//     · 合并时那一格要**重算**（值可能变），但**不能删掉不补** —— 那会丢掉一个真分型。
//   两条边界都是量出来的，不是估的（详见上面那份笔记）。
//
//   zIH/zIL 的含义与批量版一致：『这个极值是哪根原始K线贡献的』——画图精确定位用。
//   注意它们现在是**原始下标**（off 恒为 0），不再是 slice 内的相对下标。
//
//   ★ 关于数组长度（不是漏了，是故意的）：这几支和下面的 aM 都**不再截断**，
//     会一直长到「图上K线数」。上限是 Pine 的数组容量 10 万，而主流套餐单张图最多几万根
//     （原来是 >20000 就 shift 掉）。**不能 shift**：shift 掉之后数组下标就跟「原始下标」
//     错位了，而 zIH/zIL 和 aM.get(off + t) 全都按原始下标取值 —— 那是静默错位，不是省内存。
var array<float> zH  = array.new<float>()   // 标准化序列：高
var array<float> zL  = array.new<float>()   //               低
var array<int>   zIH = array.new<int>()     //               最高点来自哪根原始K线
var array<int>   zIL = array.new<int>()     //               最低点来自哪根原始K线
var array<Fx>    zFx = array.new<Fx>()      // 分型表（k 递增、顶底严格交替）
var bool  zStarted = false                  // 方向是否已定（标准化序列已有 ≥2 根）
var float zPrevH = na                       // 未定方向时扫到的最后一根候选（即原算法里的 k−1）
var float zPrevL = na
var int   zPrevI = na
var int   zN     = 0                        // 已推入的原始K线根数 = 原始下标的上界

// 重算最后一个分型格子。数组一律走参数（函数里不碰全局）。
zRefx(array<float> H, array<float> L, array<int> IH, array<int> IL, array<Fx> FX) =>
    n = H.size()
    while FX.size() > 0 and FX.get(FX.size() - 1).k >= n - 2    // 等价于批量版的 k < 长度−2 过滤
        FX.pop()
    if n >= 3
        k = n - 2
        h0 = H.get(k - 1)
        h1 = H.get(k)
        h2 = H.get(k + 1)
        l0 = L.get(k - 1)
        l1 = L.get(k)
        l2 = L.get(k + 1)
        if h1 > h0 and h1 > h2 and l1 > l0 and l1 > l2
            FX.push(Fx.new(k, IH.get(k), true, h1))
        else if l1 < l0 and l1 < l2 and h1 < h0 and h1 < h2
            FX.push(Fx.new(k, IL.get(k), false, l1))
    true

// MACD 柱（DIF − DEA，EMA 以第一根收盘价起算，与 Python 版一致）
var array<float> aM = array.new<float>()
var float emaF = na
var float emaS = na
var float dea  = na
if na(emaF)
    emaF := close
    emaS := close
    dea  := 0.0
else
    emaF += (close - emaF) * 2.0 / (mFast + 1)
    emaS += (close - emaS) * 2.0 / (mSlow + 1)
    dea  += (emaF - emaS - dea) * 2.0 / (mSig + 1)
aM.push(emaF - emaS - dea)
// ★ aM 也不再截断（原来 >20000 就 shift）：strengthOf 里是 aM.get(off + t)，off=0 时 t 就是原始下标。
//   一旦 shift，下标就和增量状态对不上了 —— 性能旋钮不能拿来讲正确性。

// ── 本根推入增量状态（下面这段就是原 standardize() 那个单遍扫描，逐行搬到顶层逐根跑）──
// ★ 未定方向那一段（原算法里的前缀扫描）。**整段互相包含时批量版塌成「第一根」**，
//   不是最后一根 —— 所以第 0 根就先摆进状态，等方向定下来那一刻再把第 0 格换成 k−1 那根。
//   （这一条我第一版照搬时漏了，是逐行对回 Python 才看见的；见 notes/pine-incremental-parity.py
//    的 snapshot()，与 core/kline.py 的 `if k >= n: return [bars[0]...]` 同义。）
zcH = q(high)
zcL = q(low)
if zH.size() == 0
    zH.push(zcH)
    zL.push(zcL)
    zIH.push(zN)
    zIL.push(zN)
    zPrevH := zcH
    zPrevL := zcL
    zPrevI := zN
else if not zStarted
    if contains(zPrevH, zPrevL, zcH, zcL)
        zPrevH := zcH                                       // 仍在互相包含：候选往后挪（状态里留的仍是第一根）
        zPrevL := zcL
        zPrevI := zN
    else
        zH.set(0, zPrevH)                                   // 方向定下来了：第 0 格换成 k−1 那根，再追加本根
        zL.set(0, zPrevL)
        zIH.set(0, zPrevI)
        zIL.set(0, zPrevI)
        zH.push(zcH)
        zL.push(zcL)
        zIH.push(zN)
        zIL.push(zN)
        zStarted := true
else
    zm = zH.size()
    zph = zH.get(zm - 1)
    zpl = zL.get(zm - 1)
    zup = zph > zH.get(zm - 2) or (zph == zH.get(zm - 2) and zpl > zL.get(zm - 2))
    if contains(zph, zpl, zcH, zcL)
        if zup                                              // 向上：两个端点都取高
            zH.set(zm - 1, math.max(zph, zcH))
            zL.set(zm - 1, math.max(zpl, zcL))
            if zcH > zph
                zIH.set(zm - 1, zN)
            if zcL > zpl
                zIL.set(zm - 1, zN)
        else                                                // 向下：两个端点都取低
            zH.set(zm - 1, math.min(zph, zcH))
            zL.set(zm - 1, math.min(zpl, zcL))
            if zcH < zph
                zIH.set(zm - 1, zN)
            if zcL < zpl
                zIL.set(zm - 1, zN)
    else
        zH.push(zcH)
        zL.push(zcL)
        zIH.push(zN)
        zIL.push(zN)
zRefx(zH, zL, zIH, zIL, zFx)
zN += 1
// ★ 本根的「喂笔」在下面笔那一节的末尾（`zPenStep` 定义之后）—— pine 要求先定义后调用。
//   中间那一段全是函数定义，不执行，所以逐根顺序仍是：标准化 → 分型 → 喂笔。

// ───────────────────────── 笔（第 77 课 + 回头修正；第 81 课新笔）─────────────────────────
far(Fx a, Fx b) => penRule == "老笔" ? b.k - a.k >= 4 : (b.k - a.k >= 3 and math.abs(b.i - a.i) >= 4)
beyond(Fx f, Fx g) => f.top ? f.p > g.p : f.p < g.p

extremeIn(Fx f, int k0, int k1, array<float> sH, array<float> sL) =>
    ok = true
    k = k0
    while k <= k1 and ok
        if f.top ? sH.get(k) > f.p : sL.get(k) < f.p
            ok := false
        k += 1
    ok

penOk(Fx a, Fx b, array<float> sH, array<float> sL) =>
    far(a, b) and extremeIn(a, a.k, b.k, sH, sL) and extremeIn(b, a.k, b.k, sH, sL)

// 把 fx 里标准化下标在 (kFrom, kTo] 的分型按顺序压到工作栈上（栈顶先处理，所以倒着压）
pushRange(array<int> stack, array<int> fxAtK, int kFrom, int kTo) =>
    k = kTo
    while k > kFrom
        idx = fxAtK.get(k)
        if idx >= 0
            stack.push(idx)
        k -= 1

// 最后一笔起点不是极值时往回修（对应 Python fix_start）；pend 放在长度 1 的数组里以便修改
fixStart(array<Fx> fx, array<int> seq, array<int> pend, array<int> stack, array<int> fxAtK, array<float> sH, array<float> sL) =>
    ns = seq.size()
    if ns >= 2
        a = fx.get(seq.get(ns - 2))
        g = fx.get(seq.get(ns - 1))
        if not extremeIn(a, a.k, g.k, sH, sL)
            int P = -1
            k = a.k + 1
            while k < g.k
                idx = fxAtK.get(k)
                if idx >= 0
                    f = fx.get(idx)
                    if f.top == a.top and (P < 0 or (a.top ? f.p > fx.get(P).p : f.p < fx.get(P).p))
                        P := idx
                k += 1
            j = ns - 3
            bool fin = false
            while j >= 0 and not fin
                e = fx.get(seq.get(j))
                if P >= 0 and e.top == g.top and e.k < fx.get(P).k and penOk(e, fx.get(P), sH, sL) and penOk(fx.get(P), g, sH, sL)
                    while seq.size() > j + 1
                        seq.pop()
                    seq.push(P)
                    pend.set(0, -1)
                    pushRange(stack, fxAtK, fx.get(P).k, g.k)
                    fin := true
                else if e.top == a.top and j <= ns - 4 and penOk(e, g, sH, sL)
                    gi = seq.get(ns - 1)
                    while seq.size() > j + 1
                        seq.pop()
                    seq.push(gi)
                    fin := true
                j -= 1
    true

// 栈的排空循环：从工作栈里取分型、喂进 (seq, pend)。批量与逐根增量**共用这一段**
// —— 两处各抄一份的话，改了一处忘了另一处是迟早的事。
zDrain(array<Fx> fx, array<float> sH, array<float> sL,
       array<int> seq, array<int> pend, array<int> stack, array<int> fxAtK) =>
    while stack.size() > 0
        fi = stack.pop()
        f = fx.get(fi)
        ns = seq.size()
        if ns == 0
            seq.push(fi)
        else
            last = fx.get(seq.get(ns - 1))
            if f.top == last.top
                if beyond(f, last)
                    pd = pend.get(0)
                    if pd >= 0 and (ns < 3 or not beyond(last, fx.get(seq.get(ns - 3))))
                        pend.set(0, -1)
                        seq.pop()
                        seq.set(seq.size() - 1, pd)
                        pushRange(stack, fxAtK, fx.get(pd).k, f.k)       // 先压：它在 fixStart 的重看之后处理
                        fixStart(fx, seq, pend, stack, fxAtK, sH, sL)
                    else
                        seq.set(ns - 1, fi)
                        pend.set(0, -1)
                        fixStart(fx, seq, pend, stack, fxAtK, sH, sL)
            else if far(last, f) and extremeIn(f, last.k, f.k, sH, sL)
                seq.push(fi)
                pend.set(0, -1)
            else if not far(last, f) and ns >= 2 and beyond(f, fx.get(seq.get(ns - 2)))
                pd = pend.get(0)
                if pd < 0 or beyond(f, fx.get(pd))
                    pend.set(0, fi)
    true

// 端点下标 → 笔。只在 islast 里调一次（O(笔数)，画图本来也要走这么多）。
zUnits(array<Fx> fx, array<int> seq) =>
    out = array.new<Unit>()
    m = seq.size()
    if m >= 2
        for t = 0 to m - 2
            a = fx.get(seq.get(t))
            b = fx.get(seq.get(t + 1))
            out.push(Unit.new(a.i, b.i, a.p, b.p, math.max(a.p, b.p), math.min(a.p, b.p)))
    out

// ── 第②步：笔逐根 ─────────────────────────────────────────────────────────
// 状态只有 (zSeq, zPend)：笔端点在 zFx 里的下标，和待定分型。zFx 只会往后加
// （① 的 zRefx 不删不改旧格 —— 证明见 core 那边的注释），所以**下标是稳定的**，
// 这里可以安心存下标而不是存分型本身。
var array<int>   zSeq  = array.new<int>()          // 笔端点：zFx 下标
var array<int>   zPend = array.from(-1)            // 待定分型：zFx 下标，-1 = 无
var array<int>   zStack = array.new<int>()         // 工作栈（每根用完即空）
var array<int>   zFxAtK = array.new<int>()         // 标准化下标 k -> zFx 下标
var array<int>   zPSt  = array.from(0)             // 已喂进 zSeq 的分型个数
var array<float> zSig  = array.from(-1.0, 0.0, 0.0, 0.0) // 已喂的**最后一个**分型的签名 [k, i, p, top]

// ── 第③步：线段逐根 ─────────────────────────────────────────────────────────
// 状态 = (zPens, zSegs, zSegI, zSegBorn, zSegSig)。zPens 是摊平笔（与 zSeq 同步的 Unit 序列），
// zSegs 是**已确认段（只增）**。前提是「已确认段前缀稳定」：mode A（默认）9 份数据 + 2000 随机序列
// 都 0 次撤销；mode B 不成立（反向分型可被后笔包含撤销），所以 B 不走逐根、在 islast 整段重算。
// ★ 为什么缓存段不会 stale：续扫只在「纯追加一笔」时复用 (zSegI, zSegBorn)，其余一切改动
//   （尾端点被换 / 缩水 / 跳变 / 深处回改）都走整段重算、从头补摊平 + 续扫归零。fix_start 能
//   回改 5 笔深（zec15@3738、zec_2h@206 实测），会碰到已确认段的末笔（endPen ≤ M-4 挡不住），
//   所以**不押**「zSeq 只动最后两格」——那说的是 zFx（② 的 zRefx 只动 k=L-2 那一格）、不是
//   zSeq；押的是「非纯追加一律重算」这条（seg-sync-deepfix-probe.py 逐根对账 0 分歧）。
var array<Unit>  zPens    = array.new<Unit>()          // 摊平笔（增量，与 zSeq 尾同步）
var array<Unit>  zSegs    = array.new<Unit>()          // 已确认段（只增）
var array<int>   zSegI    = array.from(0)              // 段扫描位置（= 上一段 endPen + 1）
var array<int>   zSegBorn = array.from(0)              // 方向确立的破位笔（case-1 的 at；case-2 归 0）
var array<int>   zSegSig  = array.from(-1, -1, -1)     // 笔序列尾签名 [last, 2nd-last, 3rd-last]（zFx 下标，-1 = 无）

// 一根一步。守卫三条 —— 正确性**不押在** ① 的"只增"不变量上，对不上就走第 3 条整段重算：
//   1) 分型表没变（长度相同且尾分型签名相同）⇒ 无事可做
//   2) 长了一格**且旧尾巴签名没变**          ⇒ 只喂新的那一个（O(1) 摊还）
//   3) 其余（缩了 / 跳变 / 尾格被改）       ⇒ 从空重算，不在旧状态上猜
// ★ 守卫 2 里那次签名比较是必须的，不是保险：只比长度的话，「旧尾巴被改 + 又长一格」
//   长度照样对得上，可被改的那一格得重喂。有了它，上面那句"不押在①的不变量上"才成立。
zPenStep(array<Fx> fx, array<float> sH, array<float> sL,
         array<int> seq, array<int> pend, array<int> stack, array<int> fxAtK,
         array<int> st, array<float> sig) =>
    m = fx.size()
    if m == 0
        while seq.size() > 0
            seq.pop()
        pend.set(0, -1)
        st.set(0, 0)
    else if m == st.get(0) and sig.get(0) == fx.get(m - 1).k and sig.get(1) == fx.get(m - 1).i and sig.get(2) == fx.get(m - 1).p and sig.get(3) == (fx.get(m - 1).top ? 1.0 : 0.0)
        st.set(0, m)                                   // 守卫 1：分型表原封不动
    else
        ok2 = m == st.get(0) + 1
        if ok2 and st.get(0) > 0                           // 旧尾巴得没被动过才敢只喂一个
            ok2 := sig.get(0) == fx.get(m - 2).k and sig.get(1) == fx.get(m - 2).i and sig.get(2) == fx.get(m - 2).p and sig.get(3) == (fx.get(m - 2).top ? 1.0 : 0.0)
        if ok2
            stack.push(m - 1)                          // 守卫 2：只喂新长出来的那个
            zDrain(fx, sH, sL, seq, pend, stack, fxAtK)
        else
            while seq.size() > 0                       // 守卫 3：整段重算
                seq.pop()
            pend.set(0, -1)
            for i = 0 to m - 1
                stack.push(i)
                zDrain(fx, sH, sL, seq, pend, stack, fxAtK)
        st.set(0, m)
        sig.set(0, fx.get(m - 1).k)
        sig.set(1, fx.get(m - 1).i)
        sig.set(2, fx.get(m - 1).p)
        sig.set(3, fx.get(m - 1).top ? 1.0 : 0.0)
    true

// ── 第②步：本根把新分型喂进增量笔状态（位置在这里是因为 pine 要先定义后调用）──
// zRefx 只可能动 k = L−2 那一格（pop 掉旧的、再按新值决定要不要补回来），所以 fxAtK
// 的维护是 O(1)：把那一格先当空、再看 zFx 尾巴是不是正好落在它上面。
// zFx 只会从**尾部**增删 ⇒ 其余分型在 zFx 里的下标**永不改变**，而 zSeq 存的就是这些下标。
if zH.size() >= 3
    kk = zH.size() - 2
    while zFxAtK.size() <= kk
        zFxAtK.push(-1)
    nf = zFx.size()
    zFxAtK.set(kk, nf > 0 and zFx.get(nf - 1).k == kk ? nf - 1 : -1)
zPenStep(zFx, zH, zL, zSeq, zPend, zStack, zFxAtK, zPSt, zSig)

// ── 实时回滚自检（开关默认关）───────────────────────────────────────────────
// ① ② 的正确性都押在"var 状态在实时 tick 上会回滚到上一根"这件事上，而这件事**本机验不了**，
// 只能上 TradingView。这个开关把它变成一眼能看的东西，不用"盯几分钟凭感觉"。
//
// ★ 查的是**数组**（aM 每根无条件 push），不是标量：标量回滚了不代表数组回滚了，
//   而 ② 押的恰恰是数组（zSeq/zFxAtK/zPSt/zSig 四个）。
// ★ 参照物只能是**引擎值** bar_index —— 它不参与 var 回滚。回滚生效则恒等式成立；
//   不生效时多推一次，第二个 tick 当场 ✗。
var bool   zSelfOK  = true
var string zSelfMsg = ""
if selfCheck
    if aM.size() != bar_index + 1
        zSelfOK  := false
        zSelfMsg := "aM.size=" + str.tostring(aM.size()) + " ≠ bar_index+1=" + str.tostring(bar_index + 1) + "（数组没回滚）"
    else if zN != bar_index + 1
        zSelfOK  := false
        zSelfMsg := "zN=" + str.tostring(zN) + " ≠ bar_index+1=" + str.tostring(bar_index + 1)
    else if zH.size() > zN
        zSelfOK  := false
        zSelfMsg := "zH.size=" + str.tostring(zH.size()) + " > zN=" + str.tostring(zN)

// ── ③ 逐根自检角标（segCheck）：在 islast 把增量 (zPens, zSegs) 跟整段重算对一遍 ──
var bool   segOK  = true
var string segMsg = ""

// ───────────────────────── 线段（第 67 / 71 / 78 课）─────────────────────────
isUp(Unit u) => u.p1 > u.p0

// 特征序列的非包含处理（第 67 课「标准特征序列」）。合并方向由 modeB 选：
//   A（modeB = false，默认）：开头按线段方向合并（向上段取高高、向下段取低低），之后按最后两根定方向。
//   B（modeB = true）：全程按线段方向合并。
// 与 Python `core/segment.py::_feature_std(elems, up, mode)` 逐支对应；两支的差别只在 m ≥ 2 那一支。
featStd(array<float> eh, array<float> el, bool up, bool modeB) =>
    mh = array.new<float>()
    ml = array.new<float>()
    n = eh.size()
    t = 0
    while t < n
        h = eh.get(t)
        l = el.get(t)
        m = mh.size()
        if m > 0 and contains(mh.get(m - 1), ml.get(m - 1), h, l)
            ah = mh.get(m - 1)
            al = ml.get(m - 1)
            goUp = modeB ? up : (m < 2 ? up : ah > mh.get(m - 2))
            mh.set(m - 1, goUp ? math.max(ah, h) : math.min(ah, h))
            ml.set(m - 1, goUp ? math.max(al, l) : math.min(al, l))
        else
            mh.push(h), ml.push(l)
        t += 1
    [mh, ml]

hasFractal(array<float> mh, array<float> ml, bool wantTop) =>
    found = false
    k = 1
    while k < mh.size() - 1 and not found
        h0 = mh.get(k - 1), h1 = mh.get(k), h2 = mh.get(k + 1)
        l0 = ml.get(k - 1), l1 = ml.get(k), l2 = ml.get(k + 1)
        if wantTop ? (h1 > h0 and h1 > h2 and l1 > l0 and l1 > l2) : (l1 < l0 and l1 < l2 and h1 < h0 and h1 < h2)
            found := true
        k += 1
    found

// 第二种情况的确认：端点之后、价格重新越过端点之前，反向段的特征序列里要出分型。返回 [确认, 破位笔(-1 = 没破)]
reverseScan(array<Unit> P, int endPen, bool segUp) =>
    n = P.size()
    pivot = P.get(endPen).p1
    eh = array.new<float>()
    el = array.new<float>()
    int ntail = 0
    int brk = -1
    j = endPen + 1
    while j < n and brk < 0
        p = P.get(j)
        if segUp ? p.hi > pivot : p.lo < pivot
            brk := j
        else
            ntail += 1
            if isUp(p) == segUp               // 反向段（方向与原段相反）的特征元素 = 与原段同向的笔
                eh.push(p.hi), el.push(p.lo)
        j += 1
    bool ok = false
    if ntail >= 3 and eh.size() >= 3
        [mh, ml] = featStd(eh, el, not segUp, featModeB)
        ok := hasFractal(mh, ml, not segUp)
    [ok, brk]

// 第二种情况在哪一笔到来时才算确认（同 Python _reverse_confirm_pen）：反向序列第一次出分型的那一笔，与 E3 那一笔取晚的。
//   只给「第一个反向线段」的 memo 用（card-753bd03a）；没确认 ⇒ n。
reverseConfirmPen(array<Unit> P, int endPen, bool segUp, int e3) =>
    n = P.size()
    pivot = P.get(endPen).p1
    eh = array.new<float>()
    el = array.new<float>()
    int ntail = 0
    int res = n
    bool fin = false
    j = endPen + 1
    while j < n and not fin
        p = P.get(j)
        if segUp ? p.hi > pivot : p.lo < pivot
            fin := true
        else
            ntail += 1
            if isUp(p) == segUp
                eh.push(p.hi), el.push(p.lo)
            if ntail >= 3 and eh.size() >= 3
                [mh, ml] = featStd(eh, el, not segUp, featModeB)
                if hasFractal(mh, ml, not segUp)
                    res := math.max(j, e3)
                    fin := true
        j += 1
    res

// 第 71 课：假设 pens[k] 的终点是分界点。返回 [情况(0 不成立 / 1 / 2), at(-1 = 无)]，含义同 Python _case_at
//   mEnd / mConf / mDir：「从第 s 笔起的第一个已完成线段」的 memo（终点笔 / 确认那一笔 / 1 上 -1 下；mEnd = -1 ⇒ 没有），由 firstSegFill 填
caseAt(array<Unit> P, int i, int k, bool up, array<int> mEnd, array<int> mConf, array<int> mDir) =>
    n = P.size()
    int cse = 0
    int at = -1
    eh = array.new<float>()
    el = array.new<float>()
    j = i + 1
    while j < k
        if isUp(P.get(j)) != up
            eh.push(P.get(j).hi), el.push(P.get(j).lo)
        j += 1
    if eh.size() > 0 and k + 1 < n
        [mh, ml] = featStd(eh, el, up, featModeB)
        e1h = mh.last()
        e1l = ml.last()
        V = P.get(k).p1
        e2h = P.get(k + 1).hi
        e2l = P.get(k + 1).lo
        if not (up ? V <= e1h : V >= e1l)
            gap = up ? e1h < e2l : e1l > e2h
            if not gap                                    // 第一种情况：第一笔 X 在中间地带
                // L78:32-38（card-753bd03a）：看 X 之后第一个反向线段 —— 它被确认之前先破 X 起点 ⇒ ① 旧段延续；
                //   先破 X 结束位置 ⇒ 提前定（L71:27）；被确认时都没破 ⇒ ② V 是终点；还没确认 ⇒ 待定。
                L = P.get(k + 1).p1
                s0 = k + 2
                okRev = s0 < n and mEnd.get(s0) >= 0 and mDir.get(s0) == (up ? 1 : -1)
                stop = okRev ? mConf.get(s0) - 1 : n - 1
                at := n
                r = k + 2
                bool fin = false
                while r <= stop and not fin
                    p = P.get(r)
                    if up ? p.hi > V : p.lo < V
                        at := r, fin := true
                    else if up ? p.lo < L : p.hi > L
                        cse := 1, at := r, fin := true
                    r += 1
                if not fin and okRev
                    cse := 1, at := mConf.get(s0)
            else                                          // 第二种情况
                float e3h = na
                float e3l = na
                jj = k + 3
                while jj < n and na(e3h)
                    e = P.get(jj)
                    if contains(e2h, e2l, e.hi, e.lo)
                        e2h := up ? math.max(e2h, e.hi) : math.min(e2h, e.hi)
                        e2l := up ? math.max(e2l, e.lo) : math.min(e2l, e.lo)
                    else
                        e3h := e.hi, e3l := e.lo
                    jj += 2
                if not na(e3h)
                    fracOk = up ? (e2h == V and e2h > e3h and e2l > e3l) : (e2l == V and e2l < e3l and e2h < e3h)
                    if fracOk
                        [ok, brk] = reverseScan(P, k, up)
                        if ok
                            cse := 2
                            at := reverseConfirmPen(P, k, up, jj - 2)   // 只给 memo 用；调用方 born 仍只取第一种情况
                        else
                            at := brk >= 0 ? brk : n
    [cse, at]

mkSeg(array<Unit> P, int a, int b, bool live) =>
    hi = P.get(a).hi
    lo = P.get(a).lo
    t = a + 1
    while t <= b
        hi := math.max(hi, P.get(t).hi)
        lo := math.min(lo, P.get(t).lo)
        t += 1
    Unit.new(P.get(a).i0, P.get(b).i1, P.get(a).p0, P.get(b).p1, hi, lo, a, b, live)

// 起点三笔是否有**公共**重叠区（L65:50-51／L77:69-70）—— 三笔各自的 [lo, hi] 交集非空。
//   ★ 要的是**三笔的公共段**，不是『相邻两笔各自重叠』：后者在『一上一下夹一窄』时也成立，
//     而那时三笔并没有共同的一段。实测 20 万组随机区间：相邻两两重叠却**无**公共段的占 8.3%。
//     ⚠ 别把它『简化』成只查相邻两组 —— 那是另一个判据，会多放约 8% 的起点进来。
//   ★ 附注（同一个判据的另一种说法）：1 维区间上『任意两笔都重叠』**等价于**『三笔有公共段』
//     （Helly 定理；实测 20 万组，0 反例）。所以 `max(lo) < min(hi)` 与『两两重叠』等价 ——
//     写不写反例都对，但**只查相邻**是错的。
//   ★ 边界取**严格** `<`：公共区间退化成一个点不算『有重叠的部分』。
//   ★ 只在**序列开头**能触发：段界由特征序列分型确认、本身已含重叠（实测 6 族随机 2481 段
//     ＋ 真实 201 段，段界之后 0 例）—— 所以段界之后不需要它兜。
//   ★★ 本函数与 Python 版 core/segment.py::_opening_overlaps 同形，但**未经运行验证**
//      （本机无 TradingView 运行时，两边都只做了静态对齐）。
openingOverlaps(array<Unit> P, int i) =>
    bool ok = false
    if i + 2 < P.size()
        lo = math.max(math.max(P.get(i).lo, P.get(i + 1).lo), P.get(i + 2).lo)
        hi = math.min(math.min(P.get(i).hi, P.get(i + 1).hi), P.get(i + 2).hi)
        ok := lo < hi
    ok

// 「从第 s 笔起的第一个已完成线段」memo（Python _first_seg）。Pine 不许递归，所以从右往左填：
//   s 的答案只用到起点 > s 的 memo（caseAt 第一种情况查的是 k+2，k ≥ s+2），往左填时都已填好。
firstSegFill(array<Unit> P, int from, array<int> mEnd, array<int> mConf, array<int> mDir) =>
    n = P.size()
    s = n - 1
    while s >= from
        i = s
        while i + 2 < n and not openingOverlaps(P, i)
            i += 1
        int e = -1
        int c = -1
        if i + 2 < n
            up = isUp(P.get(i))
            k = i + 2
            while k < n - 1 and e < 0
                [cse, at] = caseAt(P, i, k, up, mEnd, mConf, mDir)
                if cse > 0
                    e := k
                    c := math.max(k + 1, at)
                else
                    k += 2
                    if at >= 0
                        while k < at
                            k += 2
            if e >= 0
                mDir.set(s, up ? 1 : -1)
        mEnd.set(s, e)
        mConf.set(s, c)
        s -= 1
    true

buildSegments(array<Unit> P) =>
    segs = array.new<Unit>()
    n = P.size()
    mEnd = array.new<int>(n, -1)
    mConf = array.new<int>(n, -1)
    mDir = array.new<int>(n, 0)
    firstSegFill(P, 0, mEnd, mConf, mDir)
    i = 0
    born = 0
    bool stop = false
    while i + 2 < n and not stop
        // ★ L65:50-51／L77:69-70：线段开始的那三笔必须有重叠。没有公共重叠 ⇒ i 处**构不成线段**
        //   ⇒ 往后挪一笔再看（L77:69-70 原文：「线段开始的那三笔，必须有重合，开始三笔没有重合的，是↵构不成线段的。」
        //   块内 ↵ ＝ 原文硬折行）。与 Python 版同形：
        //   挪过去的几笔都在头部、**没有上一段可并**，它们不构成任何线段（悬空前缀）。
        if not openingOverlaps(P, i)
            i += 1
            continue
        up = isUp(P.get(i))
        k = i + 2
        while k < born
            k += 2
        int endPen = -1
        int res = -1
        while k < n - 1 and endPen < 0
            [cse, at] = caseAt(P, i, k, up, mEnd, mConf, mDir)
            if cse > 0
                endPen := k
                res := cse == 1 ? at : 0
            else
                k += 2
                if at >= 0
                    while k < at
                        k += 2
        if endPen < 0
            stop := true
        else if segs.size() == 0 and (up ? P.get(endPen).p1 <= P.get(i).p0 : P.get(endPen).p1 >= P.get(i).p0)
            // ★ 图头那一段终点没越过起点 ⇒ 起点那一笔是图头外面上一段的尾巴，往后挪一笔重划（同 Python HEAD_DIR_FIX，card-24dd71cb-003）
            i += 1
            born := 0
        else
            born := res
            segs.push(mkSeg(P, i, endPen, false))
            i := endPen + 1
    if n - i >= 3
        segs.push(mkSeg(P, i, n - 1, true))
    segs

// ── ③ 增量续扫（A 模式；B 在 islast 走整段 buildSegments）──────────────────
// 与 buildSegments 的内层逐行对应，只是 (i, born) 变成跨根持久状态 (zSegI, zSegBorn)、
// segs 变成只增的 var。每根最多确认 1 段（多数 0 段），摊还 O(1)。
// 同步按 zSeq 尾部三格签名（zSegSig）分两路：
//   · 纯追加（多一笔、旧尾巴签名不动）⇒ push 一笔，续扫（旧前缀没动，复用 (zSegI, zSegBorn) 安全）；
//   · 其它（尾端点被换 / 缩水 / 跳变 / 深处被改）⇒ 摊平 + 段全作废重来。
//     ★ 尾端点被换也走整段重算、不是只重推最后一笔：换的是最后那根笔，会翻动 openingOverlaps
//       倒数几格（i-2..i）的判词；续扫的 i 只增不回，已经跳过去的位置不会再问 ⇒ 缓存段会
//       stale（seg-sync-deepfix-probe.py 实测 zec_1h@159：换最后那根笔把 openingOverlaps(0) 从
//       假翻成真，而 i 早已跳到 1，位置 0 再没被问过）。
//     ★★ 更深一层：「只从最后一个已确认段末笔之后重扫」也不安全（seg-partial-rejected.md）。
//       **已确认段本身押在尾巴上** —— case-1 的破位笔、case-2 的反向分型都要读段 endPen 之后的笔
//       直到当前尾巴，尾笔一换就能把前面已确认的段翻掉（zec_1h@1433：{73,79} endPen=79 ≤ M-4，
//       可 case-1 破位笔扫到 pens[81..82]，尾笔一换这段就撤销）。所以非纯追加一律整段重算，
//       别想省成「只重扫尾巴」—— 那个「最后已确认段」自己可能就是 stale 的。
mkPen(array<Fx> fx, array<int> seq, int t) =>
    a = fx.get(seq.get(t))
    b = fx.get(seq.get(t + 1))
    Unit.new(a.i, b.i, a.p, b.p, math.max(a.p, b.p), math.min(a.p, b.p))

zSegStep(array<Fx> fx, array<int> seq, array<Unit> pens, array<Unit> segs, array<int> segI, array<int> segBorn, array<int> sig) =>
    M = seq.size()
    e1 = M >= 1 ? seq.get(M - 1) : -1
    e2 = M >= 2 ? seq.get(M - 2) : -1
    e3 = M >= 3 ? seq.get(M - 3) : -1
    penCount = M >= 1 ? M - 1 : 0
    if penCount != pens.size() or e1 != sig.get(0) or e2 != sig.get(1) or e3 != sig.get(2)
        if penCount == pens.size() + 1 and e2 == sig.get(0) and e3 == sig.get(1)
            // 纯追加：新长出一笔（旧前缀没动，续扫即可）
            pens.push(mkPen(fx, seq, penCount - 1))
        else
            // 整段重算：清空摊平 + 已确认段，从头补摊平、续扫归零。
            // 含「尾端点被换」：换最后那根笔会翻动 openingOverlaps 倒数几格，续扫的 i 只增不回，
            // 跳过去的位置不会再问 ⇒ 缓存段 stale，所以也照缩水/跳变一样整段重算。
            while pens.size() > 0
                pens.pop()
            while segs.size() > 0
                segs.pop()
            segI.set(0, 0)
            segBorn.set(0, 0)
            while pens.size() < penCount
                pens.push(mkPen(fx, seq, pens.size()))
        sig.set(0, e1)
        sig.set(1, e2)
        sig.set(2, e3)
        // 续扫（镜像 buildSegments 内层）
        n = pens.size()
        i = segI.get(0)
        // memo 只需从续扫位置起（扫描不回头）；每根重填 —— 尾巴上未确认的反向线段会随新笔变成已确认
        mEnd = array.new<int>(n, -1)
        mConf = array.new<int>(n, -1)
        mDir = array.new<int>(n, 0)
        firstSegFill(pens, i, mEnd, mConf, mDir)
        born = segBorn.get(0)
        bool stop = false
        while i + 2 < n and not stop
            if not openingOverlaps(pens, i)
                i += 1
                continue
            up = isUp(pens.get(i))
            k = i + 2
            while k < born
                k += 2
            int endPen = -1
            int res = -1
            while k < n - 1 and endPen < 0
                [cse, at] = caseAt(pens, i, k, up, mEnd, mConf, mDir)
                if cse > 0
                    endPen := k
                    res := cse == 1 ? at : 0
                else
                    k += 2
                    if at >= 0
                        while k < at
                            k += 2
            if endPen < 0
                stop := true
            else if segs.size() == 0 and (up ? pens.get(endPen).p1 <= pens.get(i).p0 : pens.get(endPen).p1 >= pens.get(i).p0)
                // ★ 图头那一段终点没越过起点 ⇒ 起点那一笔是图头外面上一段的尾巴，往后挪一笔重划（同 Python HEAD_DIR_FIX，card-24dd71cb-003）
                i += 1
                born := 0
            else
                born := res
                segs.push(mkSeg(pens, i, endPen, false))
                i := endPen + 1
        segI.set(0, i)
        segBorn.set(0, born)
    true

zSegStep(zFx, zSeq, zPens, zSegs, zSegI, zSegBorn, zSegSig)

// ③ 自检用的整段对照：增量 (zPens, zSegs) 必须跟整段重算逐格/逐段相同。
// i0/i1 已唯一确定一根笔（p0/p1/hi/lo 都由同一对端点推出），所以只比 i0/i1；段比 PI0/PI1 + live。
pensSame(array<Unit> A, array<Unit> B) =>
    bool ok = A.size() == B.size()
    int t = 0
    while ok and t < A.size()
        if A.get(t).i0 != B.get(t).i0 or A.get(t).i1 != B.get(t).i1
            ok := false
        t += 1
    ok

segsSame(array<Unit> A, array<Unit> B) =>
    bool ok = A.size() == B.size()
    int t = 0
    while ok and t < A.size()
        if A.get(t).PI0 != B.get(t).PI0 or A.get(t).PI1 != B.get(t).PI1 or A.get(t).live != B.get(t).live
            ok := false
        t += 1
    ok

// ───────────────────────── 中枢（第 17 / 20 / 38 课）与 9 段升级（第 33 / 64 课）─────────────────────────
relOf(Ctr A, Ctr B) =>
    B.GG < A.DD ? 1 : B.DD > A.GG ? 2 : (B.ZG < A.ZD and B.GG >= A.DD) ? 3 : (B.ZD > A.ZG and B.DD <= A.GG) ? 4 : 5

findCenters(array<Unit> U, int startDir) =>
    // startDir：首笔方向约束（只给类中枢段内算用，L64:31/L64:35-36 首笔反向）。
    //   0 = 不约束（线段中枢 / 独立调用）· 1 = 首笔须向上 · -1 = 首笔须向下。
    //   笔方向严格交替，所以候选起笔方向不对就挪一格（一格即反向）。
    zs = array.new<Ctr>()
    N = U.size()
    i = 0
    while i + 2 < N
        if startDir != 0 and (isUp(U.get(i)) ? 1 : -1) != startDir
            i += 1
            continue
        a = U.get(i), b = U.get(i + 1), c = U.get(i + 2)
        ZG = math.min(a.hi, math.min(b.hi, c.hi))
        ZD = math.max(a.lo, math.max(b.lo, c.lo))
        if ZG >= ZD
            endU = i + 2
            j = i + 3
            int reason = 0
            int nxt = -1
            while j < N and reason == 0
                u = U.get(j)
                bool hit = false
                if (j - i) % 2 == 0
                    if u.lo > ZG or u.hi < ZD
                        reason := u.lo > ZG ? 3 : 4
                        nxt := j
                        hit := true
                    else
                        endU := j
                if not hit and j + 1 < N and u.p0 >= ZD and u.p0 <= ZG
                    w = U.get(j + 1)
                    if (isUp(u) and w.lo > ZG) or (not isUp(u) and w.hi < ZD)
                        reason := isUp(u) ? 1 : 2
                        endU := j - 1
                        nxt := j + 1
                if reason == 0
                    j += 1
            DD = U.get(i).lo
            GG = U.get(i).hi
            t = i
            while t <= endU
                DD := math.min(DD, U.get(t).lo)
                GG := math.max(GG, U.get(t).hi)
                t += 2
            upZD = array.new<float>()
            upZG = array.new<float>()
            nU = endU - i + 1
            g = 3
            while 3 * g <= nU
                float gZD = na
                float gZG = na
                for grp = 0 to 2
                    lo = U.get(i + grp * g).lo
                    hi = U.get(i + grp * g).hi
                    s = i + grp * g + 1
                    while s < i + (grp + 1) * g
                        lo := math.min(lo, U.get(s).lo)
                        hi := math.max(hi, U.get(s).hi)
                        s += 1
                    gZD := na(gZD) ? lo : math.max(gZD, lo)
                    gZG := na(gZG) ? hi : math.min(gZG, hi)
                upZD.push(gZD), upZG.push(gZG)
                g *= 3
            zs.push(Ctr.new(i, endU, ZD, ZG, DD, GG, reason == 0, reason, 0, -1, upZD, upZG))
            i := reason != 0 ? nxt : endU + 1
        else
            i += 1
    if zs.size() > 1
        for k = 1 to zs.size() - 1
            z = zs.get(k)
            z.rel := relOf(zs.get(k - 1), z)
    zs

// 类中枢改段内算：按线段把笔切开，每段内各自 findCenters —— 类中枢不跨线段（L65:145-146 / L57:21）。
// 每条线段（含未完成那条 live）里的笔单独跑，PI0/PI1 是段内下标，加回段起点 rebase 成全局笔下标；
// 段与段之间不接续、不合并。「与前一个中枢的关系」只在同段内算：findCenters 对每段切片已经算好了
// 段内 rel（段首 rel=0 无），这里只打 seg 归属，不再全局重算 —— 跨段不接续，每段段首 rel 就是「无」。
// 起笔（L64:31 / L64:35-36）：段首笔是与段同向的进入笔，类中枢从第一根反向笔起（下跌段里是上下上），
// 而且每个中枢的首笔都得反向、不只第一个 —— 不重叠时 findCenters 挪到下一根（同向）笔，终结后 nxt 也可能
// 落在同向笔上。所以每段跳过第 0 笔（base = PI0 + 1），再把段方向的反向传给 findCenters（首笔方向约束）。
// 已完成线段里 findCenters 会把最后那个中枢标成 live（切片到头了）—— 那是被段分界截断，
// 一律改 live=false、term=5（所在线段结束）；只有最后那条未完成线段才保留 findCenters 给的 live。
findCentersBySegment(array<Unit> pens, array<Unit> segs) =>
    zs = array.new<Ctr>()
    if segs.size() > 0                 // 空数组时 for 0 to -1 会倒着跑
        for si = 0 to segs.size() - 1
            s = segs.get(si)
            base = s.PI0 + 1
            int sdir = isUp(s) ? 1 : -1
            cs = findCenters(pens.slice(base, s.PI1 + 1), -sdir)
            if cs.size() > 0
                for ci = 0 to cs.size() - 1
                    z = cs.get(ci)
                    z.PI0 := z.PI0 + base
                    z.PI1 := z.PI1 + base
                    z.seg := si
                    if z.live and not s.live
                        z.live := false
                        z.term := 5
                    zs.push(z)
    zs

// ───────────────────────── 买卖点（第 20 / 21 / 24 课）─────────────────────────
strengthOf(Unit u, int off) =>
    float s = 0.0
    if measure == "价格斜率"
        s := math.abs(u.p1 - u.p0) / math.max(1, u.i1 - u.i0)
    else
        t = u.i0
        while t <= u.i1
            h = aM.get(off + t)
            s += isUp(u) ? math.max(h, 0.0) : -math.min(h, 0.0)
            t += 1
    s

// ── 扩展合成的大级别中枢（core/extend.py build_hierarchy 的移植）────────────────
// 前中枢 A ＋ 连接段 ＋ 后中枢 B，三段重叠出区间 [ZD, ZG]（第 49 / 30 / 54 课）；
// 之后再有中枢只要还碰到这个区间，就算震荡接进来 —— 区间不变，只扩波动范围（第 52 课）。
// 相邻两中枢是『趋势』关系时不合成（第 17 / 42 / 43 课）。**没合成的不进输出** ——
// 输出只含真合成过的高级别中枢（引擎侧 `_higher_centers` 只取 nmerge>1，与画图/卡片同口径）。
hierarchy(array<Ctr> zs, array<Unit> U) =>
    out = array.new<Ctr>()
    k = 0
    while k < zs.size()
        A = zs.get(k)
        bool merge = false
        if k + 1 < zs.size()
            rl = relOf(A, zs.get(k + 1))
            // 类中枢带 seg：合成只在同一段内（跨段不接续）；线段中枢 seg 都是 -1，退回全局合成
            merge := not A.live and A.seg == zs.get(k + 1).seg and rl != 1 and rl != 2
        if merge
            B = zs.get(k + 1)
            float s2lo = B.DD                    // 连接段的高低点；没有连接段就用后中枢自己的
            float s2hi = B.GG
            if B.PI0 - 1 >= A.PI1 + 1
                s2lo := U.get(A.PI1 + 1).lo
                s2hi := U.get(A.PI1 + 1).hi
                t = A.PI1 + 2
                while t <= B.PI0 - 1
                    s2lo := math.min(s2lo, U.get(t).lo)
                    s2hi := math.max(s2hi, U.get(t).hi)
                    t += 1
            float ZD = math.max(A.DD, math.max(s2lo, B.DD))
            float ZG = math.min(A.GG, math.min(s2hi, B.GG))
            float DD = math.min(A.DD, math.min(s2lo, B.DD))
            float GG = math.max(A.GG, math.max(s2hi, B.GG))
            int PI1 = B.PI1
            bool live = B.live
            k += 2
            while k < zs.size() and ZG >= ZD and not live
                Cn = zs.get(k)
                if Cn.seg != A.seg         // 跨段：不接续，大中枢到此为止
                    break
                if Cn.DD > ZG or Cn.GG < ZD
                    break
                DD := math.min(DD, Cn.DD)
                GG := math.max(GG, Cn.GG)
                PI1 := Cn.PI1
                live := Cn.live
                k += 1
            out.push(Ctr.new(A.PI0, PI1, ZD, ZG, DD, GG, live, 0, 0, -1,
                 array.new<float>(), array.new<float>()))
        else
            // 没合成 ⇒ 不进输出：它跟 B 是同一级，不能当『上一层的中枢』用
            k += 1
    out

// 前提③（第 53 课）：B 的中枢级别要比 A、C 里的都大，否则 A、B、C 就连成一个更大的中枢了。
// 判法（core/signals.py check_premise3 的移植，严格口径）：**上一层**有没有中枢把 A、B、C 整段包住。
//   笔层   → 上一层 = 线段中枢（scs）
//   线段层 → 上一层 = 线段中枢自己的扩展合成（hierarchy(scs, 已完成线段)）
// B 自带满 9 段升级时直接算成立（那本来就是高一级别中枢）。
p3Hit(array<Ctr> higher, Ctr B, float lo, float hi) =>
    bool hit = false
    if B.upZD.size() == 0
        for H in higher
            if H.ZD <= lo and H.ZG >= hi
                hit := true
                break
    hit

// AU：全部单位（线段层含最后一条未完成的）；Z：中枢；lastLive：AU 最后一个还在走
// higher：上一层中枢（判前提③用；线段的上一层见上）
signalsOf(array<Unit> AU, array<Ctr> Z, int nDone, bool lastLive, bool segLevel, int off, array<Ctr> higher) =>
    out = array.new<Sig>()
    nAU = AU.size()
    // 第三类：与中枢终结同一口径
    for [k, z] in Z
        if z.term == 1 or z.term == 2
            qi = z.PI1 + 2
            if qi < nAU
                u = AU.get(qi)
                out.push(Sig.new(z.term == 1 ? 3 : 6, u.i1, u.p1, not (lastLive and qi == nAU - 1), false))
    if segLevel and Z.size() > 0 and nAU > nDone
        z = Z.last()
        j = nDone - 1
        if z.live and j >= z.PI0 + 3
            u = AU.get(j)
            w = AU.get(j + 1)
            if u.p0 >= z.ZD and u.p0 <= z.ZG
                if isUp(u) and w.lo > z.ZG
                    out.push(Sig.new(3, w.i1, w.p1, false, false))
                else if not isUp(u) and w.hi < z.ZD
                    out.push(Sig.new(6, w.i1, w.p1, false, false))
    // 第一类、第二类
    if Z.size() > 1
        for k = 1 to Z.size() - 1
            B = Z.get(k)
            if B.rel == 1 or B.rel == 2
                wantDown = B.rel == 1
                int a = -1
                t = B.PI0 - 1
                while t >= 0 and a < 0
                    if isUp(AU.get(t)) != wantDown
                        a := t
                    t -= 1
                int c = -1
                for cc = B.PI1 + 1 to B.PI1 + 2
                    if c < 0 and cc < nAU and isUp(AU.get(cc)) != wantDown
                        c := cc
                if a >= 0 and c >= 0
                    C = AU.get(c)
                    newExt = wantDown ? C.lo < B.DD : C.hi > B.GG
                    if newExt and strengthOf(C, off) < strengthOf(AU.get(a), off) * divRatio
                        int ok = 0                  // 0 未定 / 1 回拉进中枢 / -1 先破 C 的极值
                        qq = c + 1
                        while qq < nAU and ok == 0
                            u = AU.get(qq)
                            if wantDown ? u.lo < C.p1 : u.hi > C.p1
                                ok := -1
                            else if wantDown ? u.hi >= B.ZD : u.lo <= B.ZG
                                ok := 1
                            qq += 1
                        if ok >= 0
                            // 前提③：上一层有没有中枢把 A、B、C 整段包住（包住 ⇒ 不构成背驰，不发点）
                            A3 = AU.get(a)
                            lo3 = math.min(A3.lo, math.min(B.DD, C.lo))
                            hi3 = math.max(A3.hi, math.max(B.GG, C.hi))
                            if not (p3On and p3Hit(higher, B, lo3, hi3))
                                cDone = not (lastLive and c == nAU - 1)
                                conf = ok == 1 and cDone
                                out.push(Sig.new(wantDown ? 1 : 4, C.i1, C.p1, conf, false))
                                if conf and c + 2 < nAU
                                    s2 = AU.get(c + 2)
                                    weak = wantDown ? s2.p1 < C.p1 : s2.p1 > C.p1
                                    out.push(Sig.new(wantDown ? 2 : 5, s2.i1, s2.p1, not (lastLive and c + 2 == nAU - 1), weak))
    out

// ───────────────────────── 画图 ─────────────────────────
var array<line>  gLines  = array.new<line>()
var array<box>   gBoxes  = array.new<box>()
var array<label> gLabels = array.new<label>()

// ★ 每类**各自的**配额 —— 不是共用一个数。
//   原先笔和线段共用一个上限：笔先画到 440，线段只剩 499-440 = 59 格。于是撞上限的用户
//   （实测只有 zec15 @ drawBars=9000：窗口内 笔 523 / 线段 67 / 笔中枢 67 / 段中枢 11）看到的
//   不是"细结构太多"，而是**线段这种粗结构被细笔挤没了**。配额按**粗结构优先**排：
//   线段 / 段中枢先占住自己那份，笔 / 类中枢只能拿剩下的。
//   下面的数是照上面那组**实测最坏值**往上留余量定的，不是拍的：
//     线段 峰值 67  → 给 150（约 2.2 倍）
//     笔   峰值 523 → 拿剩下的 349；★ 这一档**必然丢**，但丢的是最老的那头（见 islast 里的倒序）
//     段中枢 峰值 11 → 给 120；笔中枢峰值占 82 格（1 + upZD 高框）→ 给 378
//   三组合计都压在 max_*_count = 500 那条硬线以内，且各留 1~2 格给自检角标。
//   ★ 标签分两档：**买卖点**单独留 300（挤不着），中枢那两类再分 198。
//     中枢这 198 里，段中枢（价签，重要）和笔中枢（价签 + 高一级别标签）**各留一半** ——
//     同 Boxes 的道理：笔中枢先画，若共用一个数，段中枢的价签会被高一级别标签挤掉。
//     ★ 2026-10-02 起这条分界**真的开始起作用了**，不再是"为哪天撞到准备"。原来笔中枢那族
//       只在满 9 段时出一个「↑高一级」，全库实测合计 26 个，撞不到 99；小栋要求「每一个中枢
//       都标 [ZD, ZG]」之后，笔中枢这族变成「每个类中枢 1 个价签 + 升级另算」。逐份实测（全窗口）：
//         zec15 类中枢 142 个、盒子占 176/378，**标签要 176 个只有 99 格 → 丢 77**；
//         其余每一份都装得下（第二挤的 zec_1h：43 个中枢、要 52 个标签）；线段中枢那族最多
//         zec15 的 19 个中枢 / 21 个标签，每一份都装得下。
//       丢的 77 个是**最老的那些类中枢的价签** —— 倒序画、配额用完就 break，正好就是小栋要的
//       「撞上限时保留最新的」。★ **线段中枢的价签不受影响**：它的 99 是在笔中枢画完之后另算的
//       （见 islast 里 lbLimSC 那两行的位置注释），笔中枢再多也吃不掉它。
//       算术在 notes/pine-label-quota.py（逐份数据重算一遍，谁都能复跑）。
int LINE_BUDGET = 499
int PEN_LINE_CAP = 349
int SEG_LINE_CAP = LINE_BUDGET - PEN_LINE_CAP          // 150
int BOX_BUDGET  = 498
int PC_BOX_CAP  = 378
int SC_BOX_CAP  = BOX_BUDGET - PC_BOX_CAP              // 120
int LB_BUDGET   = 498
int SIG_LB_CAP  = 300
int CTR_LB_CAP  = LB_BUDGET - SIG_LB_CAP               // 198
int PC_LB_SHARE = CTR_LB_CAP / 2                       //  99：类中枢（价签 + 高一级别标签）
int SC_LB_SHARE = CTR_LB_CAP - PC_LB_SHARE             //  99：线段中枢（价签 + 高一级别标签）

// 画图的 x：一律夹到**画图窗口左沿** xL = bar_index - drawBars（drawBars ≤ 9000）。
//   原来按 9990 夹（「往回最多 10000 根」）—— 但真机上历史缓冲的上限不是 10000：小栋 10-03 ZECUSDT 15m
//   报 'offset 9271 > 9270'（bar 20785，画线段那行）。起点早于缓冲、终点在窗口里的线一画就炸。
//   窗口左沿本来就是「早于此的结构不画」那条线（x0Draw = n - 1 - drawBars - off ⇔ base + x0Draw == xL），
//   所以夹到它上面不丢任何该画的东西；math.min 防 bar_index < drawBars 时夹出负数。
xL() => bar_index - math.min(drawBars, bar_index)
xc(int x) => math.max(x, xL())
// 线被夹时**不许变形**：夹过的端点的价格按原线两端点线性插值（框直接截左边，不用插）。
//   (y1 - y0) 是 float，先乘后除 ⇒ 不走整数除法。
yAt(int x0, float y0, int x1, float y1, int x) =>
    x1 == x0 ? y0 : y0 + (y1 - y0) * (x - x0) / (x1 - x0)
// 画一条可能伸出窗口左沿的线：两端都夹到窗口里、价格沿原线插值；整条都在窗口左边就不画（返回 na）。
clipLine(int x0, float y0, int x1, float y1, color col, int w, string st) =>
    line ln = na
    if math.max(x0, x1) >= xL()
        a = xc(x0)
        b = xc(x1)
        ln := line.new(a, yAt(x0, y0, x1, y1, a), b, yAt(x0, y0, x1, y1, b), color = col, width = w, style = st)
    ln

clearAll() =>
    for l in gLines
        l.delete()
    for b in gBoxes
        b.delete()
    for lb in gLabels
        lb.delete()
    gLines.clear(), gBoxes.clear(), gLabels.clear()

// 规则 B（小栋 2026-10-02T06:21Z 定，见文件头 :9-11）—— 中枢框的虚实，三档，**顺序不能反**：
//   ① hasUnfinished：前三笔（段）里夹着「还没走完」的那一员 ⇒ **整框虚线**，等它走完再转实线；
//   ② not z.live：中枢**已结束** ⇒ **整框实线**（上下沿早就定死了，延续那截不用再标虚线）；
//   ③ z.live：**仍在延续** ⇒ **拆两截**，前三那截实线、延续那截虚线，分界在第三个成员的终点 `xm`。
//   ★ 先判 ① 再判 ② 最后 ③。反过来先看 z.live 的话，「还在长、但前三里夹着未完成笔」的中枢会
//     被判成 ③ 去拆两截 —— 而它该是整框虚线。口径与 Python 版 render/full_common.py 的 box_split 一致。
//   ★ 拆两截的落法：Pine 的 box **四条边一起画**，画不出「只有右边虚」的半框 —— 所以先铺一张整框
//     （①③ 虚 / ② 实），③ 再叠一张**只画边框、填色全透明**的前三截实框盖上去。底下那张的虚线只会在
//     分界右边露出来（要的就是这个），代价是分界处多一条竖边（Python 那边是 6 条边、没有这条）——
//     这条竖线正好标出「前三到此为止」，留着。
//   hasUnfinished / xm 都由**调用点**按层算（笔层＝最后一根笔；线段层没有这一员，见调用点）。
//
// ★ 配额检查必须在**这里**、不能留在调用点：下面 `upZD` 那组高一级别框是**本函数自己**推的，
//   原先调用点写的 `gBoxes.size() < 480` 根本管不到它们 —— 480 从来就不是硬上限，只是"进场门槛"。
//   现在改成**先算总账再进场**：一次要占 1 + （拆两截时的 1）+ upZD.size() 格，不够就整块不画。
zdN(Ctr z) => showUp ? z.upZD.size() : 0

// 返回 false = 配额不够、这次没画。调用点据此 break（倒序走，再往前只会更老，画了也是丢）。
// `upC` = 这一族升上去的高一级别框用什么颜色（类中枢 → upColPen，线段中枢 → upColSeg）。
//   它是**参数**不是全局量：同一个 drawCenter 两个调用点，颜色只能由调用点说了算。
drawCenter(Ctr z, int x0, int x1, color col, int w, int fillTr, bool withLabel, bool hasUnfinished, int xm, int boxCap, int lbCap, color upC) =>
    wholeDash = hasUnfinished
    split = not wholeDash and z.live and xm > x0 and xm < x1
    ok = false
    if gBoxes.size() + 1 + (split ? 1 : 0) + zdN(z) <= boxCap
        // ★ 拆两截时底框必须是**虚线**，上面再盖前三那截实线 —— 底框画成实线的话，
        //   延续那截就看不出虚（小栋 2026-10-02T13:23Z 真机截图指出：延续中的类中枢整框实线）。
        gBoxes.push(box.new(x0, z.ZG, x1, z.ZD, border_color = col, border_width = w,
             border_style = (wholeDash or split) ? line.style_dashed : line.style_solid,
             bgcolor = color.new(col, fillTr)))
        if split                                   // ③ 前三那截盖成实线；底下的填充只铺一次（这张全透明）
            gBoxes.push(box.new(x0, z.ZG, xm, z.ZD, border_color = col, border_width = w,
                 border_style = line.style_solid, bgcolor = color.new(col, 100)))
        if withLabel and gLabels.size() < lbCap
            gLabels.push(label.new(x0, z.ZG, str.format("[{0}, {1}]", str.tostring(z.ZD, format.mintick), str.tostring(z.ZG, format.mintick)),
                 // 价签样式：**实底 + 黑字**。2026-10-02 下半天改口（上午那版是 30% 同色底 + 白字，只按深色底挑的）：
                 //   小栋看的是**白底**图，30% 的淡底压在白底上几乎还是白，白字对淡底只有 1.33~1.45:1 —— 等于没字。
                 //   实底的好处是**读不读得清跟图底色无关**（底不透明），深浅两套主题同一份代码都过 AA。
                 //   ★ 两边透明度语义反着：这边第二个参数是**透明度**（0 = 不透明，所以这里直接写 col），Python 那边 alpha 255 = 不透明。
                 style = label.style_label_lower_left, color = col, textcolor = color.black, size = size.small))
        if zdN(z) > 0
            for [m, uzd] in z.upZD
                uzg = z.upZG.get(m)
                // 高一级别**不套规则 B**：它的「前三」没有定义（由子级别中枢构成，不是笔 / 线段）。
                // 沿用旧口径 —— 中枢没结束就虚线、结束了实线；颜色按族取（类中枢升的浅紫 / 线段中枢升的品红），
                // ★ 线宽 = `w`（母框的线宽），**不再加粗**（原 `w + 2 * (m + 1)`，级别靠粗几像素来分 ——
                //   2026-10-02 小栋把这条通道收掉了：级别由颜色 + 标签文字区分）。
                gBoxes.push(box.new(x0, uzg, x1, uzd, border_color = upC, border_width = w,
                     border_style = z.live ? line.style_dashed : line.style_solid,
                     bgcolor = color.new(upC, upFillTr)))
                if gLabels.size() < lbCap
                    // 价签样式跟母框那支**同一个写法**（实底 + 黑字，理由见上面那一处）；
                    // 文本带上自己的区间：小栋说升级中枢要写成「↑高一级 [ZD, ZG]」。
                    gLabels.push(label.new(x0, uzg, str.format("↑高{0}级 [{1}, {2}]", array.from("一", "两", "三", "四").get(math.min(m, 3)), str.tostring(uzd, format.mintick), str.tostring(uzg, format.mintick)),
                         style = label.style_label_lower_left, color = upC, textcolor = color.black, size = size.small))
        ok := true
    ok

if barstate.islast
    clearAll()
    n = zN                                            // 原始K线根数（不再截断 —— 增量状态从第 0 根攒起）
    off = 0                                           // ★ 相对下标 == 原始下标。保留这个名字只为 signalsOf/strengthOf 的调用点不动：aM.get(off + t)
    base = bar_index - (n - 1) + off                  // 原始下标 i 对应的 bar_index = base + i
    // ① 的产物（zH/zL/zIH/zIL/zFx）和 ② 的产物（zSeq）现在都只在**逐根**那一段用；
    // islast 这里不再需要 sH/sL/sIH/sIL/fx 那几个别名了（原来是喂 buildPens 的）。
    pens = zPens                                      // ② 的产物：摊平笔（逐根增量维护，见 zSegStep）
    // ★ segs 必须在 if 外面声明：Pine 里 if 块内声明的变量出了块就不存在（小栋真机编译报「segs 未定义」）。
    //   B：全程按线段方向合并 ⇒ 前缀不稳定，整段重算；A：已确认段增量维护，这里补 live 尾巴（不落 var）。
    segs = featModeB ? buildSegments(pens) : array.copy(zSegs)
    if not featModeB and pens.size() - zSegI.get(0) >= 3
        segs.push(mkSeg(pens, zSegI.get(0), pens.size() - 1, true))
    done = array.new<Unit>()
    for s in segs
        if not s.live
            done.push(s)
    pcs = findCentersBySegment(pens, segs)
    scs = findCenters(done, 0)
    // ③ 逐根自检：把增量 (zPens, zSegs) 跟整段重算对一遍（A 模式才做；B 本来就整段）
    if segCheck and not featModeB
        pensRef = zUnits(zFx, zSeq)
        bool okPens = pensSame(zPens, pensRef)
        bool okSegs = okPens and segsSame(segs, buildSegments(pensRef))
        segOK  := okPens and okSegs
        segMsg := not okPens ? "摊平笔不一致" : not okSegs ? "确认段不一致" : ""
    x0Draw = n - 1 - drawBars - off                    // 相对下标：早于此的结构不画
    np = pens.size()

    // ★★ 一律**从最新往回画**。超了要丢掉的是**最老**的那一头。
    //   原先全是正序（最老 → 最新）配 `size() < 上限`，先撞上限、被丢的是**最新那段** ——
    //   表现为"图右边空着、左边满满一屏"，正好和用户的直觉相反。
    //
    // ★ 倒序写法与三个坑（都不是猜的）：
    //   1) `for k = arr.size() - 1 to 0` 靠 Pine 的**方向自动判定**（from > to 就往下数，见
    //      语言参考 `for` 条）。**不要**画蛇添足加 `by -1`：文档里 step 是正数（"a positive value"），
    //      v5 上加 by -1 直接报 `step must be greater than 0`。
    //   2) **每个倒序 for 前面一律判空**。空表时 from = -1、to = 0，方向又翻回正序，
    //      于是 get(-1) 越界 —— 空集合这个坑对正序写法同样成立（`for q = 0 to cnt - 1` 在
    //      cnt = 0 时也变成往下数），两种写法都得先判空，判完空倒序反而更好读。
    //   3) `break` 只在**配额用完**时用，不按窗口下标 break：那要求数组严格有序，
    //      是额外的不变量；窗口仍用 `>= x0Draw` 过滤，倒序走一遍本来就便宜。
    int nPenDrawn = 0
    int nSegDrawn = 0
    int nSigDrawn = 0
    // ★ 两类中枢的框上限要按**各自的起点**算，不能拿全局 gBoxes.size() 去比一个小配额：
    //   笔中枢先画、把 gBoxes 填到几十上百，段中枢再去比 `size() < 120` 就**一个都画不出来**。
    //
    // ★★ 位置是**这个 bug 的全部**：`boxLimSC`/`lbLimSC` **必须在笔中枢画完之后**才算。
    //   我第一版把四个上限写在同一个地方（都在两个循环**之前**），那时 clearAll 刚做完、
    //   gBoxes.size()==0 ⇒ boxLimSC 就等于**绝对值 120**，等于病情原封不动，只是注释里写着
    //   "按各自起点算" —— **意图写对了，位置放错了**。@nova-8980 逐行读出来才发现的。
    //   实测上它当时还没显形（zec15@9000 笔中枢只占 82 格 < 119，段中枢还挤得进去），
    //   余量只剩 38 格 ⇒ 是"靠数据碰巧没触发"，不是"对"。
    boxLimPC = gBoxes.size() + PC_BOX_CAP
    lbLimPC = gLabels.size() + PC_LB_SHARE

    if showPC and pcs.size() > 0
        for k = pcs.size() - 1 to 0
            z = pcs.get(k)
            a = pens.get(z.PI0).i0
            b = pens.get(z.PI1).i1
            if b >= x0Draw
                // 规则 B ①：笔层「还没走完的那一员」＝**最后一根笔**（下标 np - 1，它的终点还会被更极端的
                //   分型替换）。判它有没有夹在前三个成员里 —— 等价于 Python 的 `j0 <= np-1 < min(j0+3, np)`：
                //   后半段 `np-1 < np` 恒真，所以只剩 `np - 1 < z.PI0 + 3`。
                hasUnf = np - 1 < z.PI0 + 3
                // 规则 B ③ 的分界：第三个成员的终点（中枢不足三个成员时退回最后一根笔的终点）
                xm = xc(base + pens.get(math.min(z.PI0 + 2, np - 1)).i1)
                // ★ 第 7 个实参 `true`（原来传 false）：2026-10-02 小栋要「每一个中枢左上角都标 [ZD, ZG]」，
                //   类中枢也不例外。这一下笔中枢这族的标签需求从「只有升级标签」变成「每个中枢 1 个价签 + 升级另算」
                //   —— 配额够不够见 PC_LB_SHARE 那段的算术。
                if not drawCenter(z, xc(base + a), xc(base + b), penCol, 1, pcFillTr, true, hasUnf, xm, boxLimPC, lbLimPC, upColPen)
                    break
    // ★★ 段中枢的天花板**只能在这里算**：上面那个循环已经画完笔中枢，gBoxes / gLabels 是当下的真实占用。
    //   放到上面去（和 boxLimPC 并排）就退化成"拿绝对值 120 去比全局占用"，段中枢会被笔中枢挤没 ——
    //   这个位置本身就是修复内容，不是排版问题。
    boxLimSC = gBoxes.size() + SC_BOX_CAP
    lbLimSC = gLabels.size() + SC_LB_SHARE

    if showSC and scs.size() > 0
        for k = scs.size() - 1 to 0
            z = scs.get(k)
            a = done.get(z.PI0).i0
            b = done.get(z.PI1).i1
            if b >= x0Draw
                // 规则 B ①：线段层**没有**「还没走完的那一员」—— 线段中枢只由**已完成**线段（done）算出来，
                //   那条 live 段根本不进 done ⇒ 这一档恒不触发（与 Python 版传 None 一致）。
                // 规则 B ③ 的分界：第三条已完成线段的终点（不足三条时退回最后一条的终点）
                xm = xc(base + done.get(math.min(z.PI0 + 2, done.size() - 1)).i1)
                if not drawCenter(z, xc(base + a), xc(base + b), segCol, 2, scFillTr, true, false, xm, boxLimSC, lbLimSC, upColSeg)
                    break
    if showPen and np > 0
        for t = np - 1 to 0
            p = pens.get(t)
            if p.i1 >= x0Draw
                if nPenDrawn >= PEN_LINE_CAP
                    break
                nPenDrawn += 1
                gLines.push(clipLine(base + p.i0, p.p0, base + p.i1, p.p1, penCol, penW,
                     t == np - 1 ? line.style_dashed : line.style_solid))
    if showSeg and segs.size() > 0
        for si = segs.size() - 1 to 0
            s = segs.get(si)
            if s.i1 >= x0Draw
                if nSegDrawn >= SEG_LINE_CAP
                    break
                nSegDrawn += 1
                xe = s.i1
                ye = s.p1
                if s.live                              // 未完成段画到迄今的极值
                    ye := isUp(pens.get(s.PI0)) ? s.hi : s.lo
                    t = s.PI0
                    while t <= s.PI1
                        if pens.get(t).p1 == ye
                            xe := pens.get(t).i1
                        t += 1
                gLines.push(clipLine(base + s.i0, s.p0, base + xe, ye, segCol, segW,
                     s.live ? line.style_dashed : line.style_solid))

    segLevel = sigLevel == "线段中枢"
    // 前提③ 的『上一层』：笔层 = 线段中枢；线段层 = 线段中枢自己再扩展合成一级
    array<Ctr> higher = scs
    if segLevel
        higher := hierarchy(scs, done)
    sigs = segLevel ? signalsOf(segs, scs, done.size(), segs.size() > done.size(), true, off, higher) :
                      signalsOf(pens, pcs, np, true, false, off, higher)
    names = array.from("一买", "二买", "三买", "一卖", "二卖", "三卖")
    shows = array.from(show1B, show2B, show3B, show1S, show2S, show3S)
    if sigs.size() > 0
        for gi = sigs.size() - 1 to 0                  // 倒序，同上面那三组：丢最老的
            s = sigs.get(gi)
            if shows.get(s.kind - 1) and (s.confirmed or showPend) and s.bar >= x0Draw
                if nSigDrawn >= SIG_LB_CAP
                    break
                nSigDrawn += 1
                buy = s.kind <= 3
                col = buy ? buyCol : sellCol
                txt = names.get(s.kind - 1) + (s.weak ? "(弱)" : "") + (s.confirmed ? "" : "?")
                gLabels.push(label.new(xc(base + s.bar), s.price, txt,
                     style = buy ? label.style_label_up : label.style_label_down,
                     color = s.confirmed ? col : color.new(col, 100), textcolor = s.confirmed ? color.white : col,
                     size = size.small))

    // 回滚自检角标
    if selfCheck
        gLabels.push(label.new(bar_index, high, zSelfOK ? "回滚自检 ✓" : "回滚自检 ✗  " + zSelfMsg,
             style = zSelfOK ? label.style_label_down : label.style_label_up,
             color = zSelfOK ? color.new(color.green, 15) : color.new(color.red, 0),
             textcolor = color.white, size = size.normal))
    // 线段逐根自检角标（A 模式；B 本来整段，不比）
    if segCheck and not featModeB
        gLabels.push(label.new(bar_index, low, segOK ? "线段自检 ✓" : "线段自检 ✗  " + segMsg,
             style = segOK ? label.style_label_down : label.style_label_up,
             color = segOK ? color.new(color.green, 15) : color.new(color.red, 0),
             textcolor = color.white, size = size.normal))
